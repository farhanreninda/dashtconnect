---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; light?: ImageMetadata; width: number; alt: string; eager?: boolean; }
const { src, light, width, alt, eager = false } = Astro.props;
const lightImage = light ? await getImage({ src: light, width: Math.min(width, light.width), format: 'webp' }) : null;
---
<picture>
  {lightImage && <source data-theme-light srcset={lightImage.src} width={lightImage.options.width} height={lightImage.options.height} />}
  <Image src={src} width={width} alt={alt} format="webp" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} />
</picture>
