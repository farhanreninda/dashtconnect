---
import { Image, getImage } from 'astro:assets';
import Icon from '../components/Icon.astro';
import ThemeScreenshot from '../components/ThemeScreenshot.astro';
import GalleryControls from '../components/GalleryControls.astro';
import '../styles/global.css';
import logo from '../assets/logo.png';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
import type { ImageMetadata } from 'astro';
const lightFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/light/*.png', { eager: true });
const lightImage = (name: string) => lightFiles[`../assets/screenshots/light/${name}.png`]?.default;
const image = (name: string) => files[`../assets/screenshots/${name}.png`]?.default || lightImage(name);
const fullImages = Object.fromEntries(await Promise.all(Object.entries(files).map(async ([path, asset]) => [path.split('/').pop()!.replace('.png', ''), (await getImage({ src: asset.default, width: asset.default.width, format: 'webp', quality: 90 })).src])));
const lightFullImages = Object.fromEntries(await Promise.all(Object.entries(lightFiles).map(async ([path, asset]) => [path.split('/').pop()!.replace('.png', ''), (await getImage({ src: asset.default, width: asset.default.width, format: 'webp', quality: 90 })).src])));
const lightSessions = new Set(['carplay', 'controls-idle', 'music', 'dashboard', 'music-library', 'maps']);
const availableTheme = (name: string) => lightSessions.has(name) ? 'light' : lightImage(name) && files[`../assets/screenshots/${name}.png`] ? 'both' : lightImage(name) ? 'light' : 'dark';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const repo = 'https://github.com/farhanreninda/dashtconnect';
const favicon = await getImage({ src: logo, width: 64, format: 'png' });
const hero = await getImage({ src: image('carplay'), width: 1600, format: 'webp' });
const stories = [
  { title: 'Mulai dari satu tempat.', label: 'Beranda', text: 'Buka receiver, pilih iPhone yang dipasangkan, dan lihat jalur koneksi ke layar mobil.', points: ['Bluetooth menyiapkan sambungan iPhone.', 'Wi-Fi lokal membawa gambar dan audio.'], shots: ['home', 'home-landscape'] },
  { title: 'Panduan yang selalu bisa dibuka.', label: 'Panduan', text: 'Siapkan perangkat lewat tutorial empat langkah, pintasan Wi-Fi dan Bluetooth, serta bantuan sesuai masalah koneksi.', points: ['Uji tampilan dengan empat target warna dan penghitung sentuhan.', 'Periksa gambar dan sentuhan melalui T-Link.'], shots: ['guide', 'guide-landscape'] },
  { title: 'Atur layar sesuai kebutuhan.', label: 'Pengaturan', text: 'Pilih tema, redupkan layar HP, dan lihat informasi perangkat dari satu menu.', points: ['Mode redup berlaku saat DashTConnect terbuka.', 'Layar HP tetap menyala selama sesi.'], shots: ['settings', 'settings-landscape'] },
  { title: 'Terang, gelap, atau ikuti HP.', label: 'Tema aplikasi', text: 'Pilihan tema aplikasi tersimpan untuk penggunaan berikutnya. Layout mengikuti orientasi perangkat.', points: ['Tema sistem, terang, dan gelap.', 'Navigasi di sisi layar saat landscape.'], shots: ['appearance', 'appearance-landscape'] },
  { title: 'Kenali Android yang terhubung.', label: 'Informasi perangkat', text: 'Lihat model, versi Android, keadaan jaringan, suhu baterai, daya eksternal, dan detail teknis perangkat.', points: ['Arsitektur, hardware, USB host, dan Wi-Fi Direct.', 'Perbarui pembacaan beserta waktunya.'], shots: ['device', 'device-landscape'] },
];
const archive = [
  ['device-technical', 'Detail teknis perangkat'], ['home-scrolled', 'Beranda, bagian bawah'], ['help-landscape', 'Bantuan koneksi landscape'], ['display-test', 'Uji tampilan dan sentuhan'], ['about', 'Tentang aplikasi portrait'], ['help', 'Bantuan koneksi'], ['help-expanded', 'Petunjuk T-Link'], ['about-landscape', 'Tentang DashTConnect'],
  ['receiver', 'Pilih iPhone'], ['connecting', 'Menghubungkan iPhone'], ['dashboard', 'Dashboard CarPlay'],
  ['music-library', 'Koleksi musik'], ['maps', 'Google Maps'],
];
const steps = [
  ['Kenali alur koneksi', 'iPhone menjadi sumber CarPlay. Android menjalankan receiver, lalu T-Link meneruskan tampilan ke head unit.'],
  ['Siapkan Android', 'Aktifkan Wi-Fi dan Bluetooth, lalu pasangkan iPhone melalui pengaturan Bluetooth Android.'],
  ['Hubungkan ke T-Link', 'Saat parkir, sambungkan Android ke USB head unit dengan kabel data. Buka T-Link dan periksa gambar serta sentuhan.'],
  ['Mulai receiver', 'Matikan data seluler dan putuskan Wi-Fi berinternet di Android. Mulai receiver, berikan izin, pilih iPhone, dan hubungkan.'],
];
const faqs = [
  ['Apakah Android membutuhkan internet?', 'Android memakai koneksi lokal ke iPhone. Matikan data seluler Android dan putuskan Wi-Fi berinternet, tetapi biarkan Wi-Fi serta Bluetooth tetap aktif. Internet digunakan di iPhone.'],
  ['Apa perbedaan Bluetooth dan Wi-Fi lokal?', 'Bluetooth menyiapkan sesi dengan iPhone. Gambar dan audio CarPlay diteruskan melalui Wi-Fi lokal antara kedua perangkat.'],
  ['Mengapa aplikasi meminta izin mikrofon?', 'Izin mikrofon diperlukan untuk jalur audio CarPlay. Mikrofon digunakan saat iPhone meminta masukan suara dalam sesi aktif. Izin perangkat sekitar diperlukan untuk Bluetooth.'],
  ['Apakah mode redup mematikan layar HP?', 'Mode redup menurunkan kecerahan jendela DashTConnect. Layar tetap menyala. Kecerahan dapat dipulihkan lewat pintasan sesi atau Pengaturan.'],
  ['Apa fungsi Uji tampilan?', 'Empat target warna menampilkan penghitung sentuhan. Tampilkan melalui T-Link, tekan target dari head unit, lalu cocokkan angkanya di Android. Sentuhan langsung di HP juga menambah penghitung.'],
  ['Dari perangkat apa screenshot ini?', 'Screenshot dikirim pemilik proyek dari Samsung A04s dengan DashTConnect 0.7.3. Sesi CarPlay memakai iPhone 11. Tampilan dan daftar aplikasi mengikuti pengaturan perangkat.'],
];
const description = 'DashTConnect: receiver CarPlay di Android. Lihat seluruh screenshot asli, fitur koneksi lokal iPhone, kontrol layar, dan panduan T-Link.';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DashTConnect | CarPlay dari iPhone, terhubung lewat Android</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f7f9" />
    <link rel="canonical" href="https://farhanreninda.my.id/dashtconnect/" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="preload" href={`${base}fonts/SpaceGrotesk.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" /><meta property="og:locale" content="id_ID" />
    <meta property="og:title" content="DashTConnect | iPhone, Android, dan layar mobil" />
    <meta property="og:description" content={description} /><meta property="og:url" content="https://farhanreninda.my.id/dashtconnect/" />
    <meta property="og:image" content={new URL(hero.src, Astro.site).href} />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('dashtconnect-theme'); } catch {}
        const theme = saved === 'dark' || saved === 'light' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#0e141e' : '#f6f7f9';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <header class="site-header"><div class="header-inner wrap">
      <a class="brand" href={base} aria-label="DashTConnect, beranda"><Image src={logo} width={36} height={36} alt="" />DashTConnect</a>
      <button class="theme-toggle" aria-label="Aktifkan tema gelap" aria-pressed="false" hidden><span class="theme-symbol" aria-hidden="true">◐</span></button>
      <button class="menu-toggle" aria-label="Buka navigasi" aria-expanded="false" aria-controls="site-nav"><Icon name="menu" /></button>
      <nav id="site-nav" aria-label="Navigasi utama"><a href="#fitur">Fitur</a><a href="#tampilan">Screenshot</a><a href="#panduan">Panduan</a><a href="#pertanyaan">FAQ</a><a class="nav-repo" href={repo}><Icon name="github" size={19} />GitHub</a></nav>
    </div></header>
    <main id="konten">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-intro"><div><p class="eyebrow">iPhone → Android → Layar mobil</p><h1 id="hero-title">CarPlay dari iPhone.<br />Terhubung lewat <span>Android.</span></h1></div><div class="hero-copy"><p>Jadikan Android sebagai receiver CarPlay. Koneksi lokal membawa gambar dan audio dari iPhone, lalu T-Link meneruskannya ke layar mobil.</p><div class="hero-actions"><a class="button primary" href="#tampilan">Jelajahi tampilan<Icon name="arrow" size={18} /></a><a class="text-link" href="#panduan">Panduan koneksi</a></div><p class="hero-note">Internet tetap di iPhone.</p></div></div>
        <figure class="hero-product"><button class="screen-frame shot-button" data-lightbox data-full={fullImages['carplay-dark']} data-full-light={hero.src} data-caption="CarPlay terhubung di Samsung A04s." aria-label="Perbesar screenshot CarPlay yang terhubung"><ThemeScreenshot src={image('carplay-dark')} light={image('carplay')} width={1600} alt="CarPlay berjalan di Samsung." eager /><span class="expand-hint"><Icon name="expand" size={17} />Perbesar</span></button><figcaption><span>Screenshot asli, langsung dari perangkat.</span><span>Samsung A04s · iPhone 11 · v0.7.3</span></figcaption></figure>
      </section>
      <section class="connection-section wrap" aria-labelledby="connection-title"><div class="section-heading"><div><p class="section-number">01 / Jalur koneksi</p><h2 id="connection-title">Tiga perangkat.<br />Satu alur.</h2></div><p>Bluetooth menyiapkan sambungan. Wi-Fi lokal membawa gambar dan audio. Android tetap tanpa akses internet selama sesi.</p></div><div class="connection-flow">{[['phone','iPhone','Sumber CarPlay, aplikasi, dan internet.'],['screen','Android','Receiver gambar, audio, dan kontrol sentuh.'],['car','Head unit','Tampilan Android melalui T-Link dan kabel data.']].map(([icon,title,text]) => <div><span class="device-symbol"><Icon name={icon as 'phone' | 'screen' | 'car'} size={30} /></span><h3>{title}</h3><p>{text}</p></div>)}</div></section>
      <section id="fitur" class="runtime-section" aria-labelledby="runtime-title"><div class="wrap"><div class="runtime-heading"><div><p class="section-number">02 / Saat terhubung</p><h2 id="runtime-title">Layar penuh.<br />Kontrol seperlunya.</h2></div><p>CarPlay mengikuti rasio layar Android dalam orientasi landscape. Gambar, musik, dan sentuhan berada dalam satu sesi.</p></div><div class="runtime-layout"><div class="control-notes"><article><Icon name="touch" /><h3>Geser, lepas, menempel ke tepi.</h3><p>Tombol mengambang bergerak ke tepi terdekat setelah dilepas, agar tidak menghalangi kontrol CarPlay.</p></article><article><span class="time-label">3 / 10 dtk</span><h3>Kontrol yang tahu kapan meredup.</h3><p>Menu menutup dan tombol memudar setelah tiga detik. Setelah sepuluh detik tanpa interaksi, tombol kembali ke kiri bawah.</p></article><article><Icon name="sun" /><h3>Redupkan HP, lanjutkan sesi.</h3><p>Turunkan kecerahan dari pintasan sesi, lalu pulihkan kapan saja. Hentikan receiver dari kontrol yang sama.</p></article></div><div class="runtime-media">{[['controls-idle','Tombol mengambang memudar saat tidak digunakan.'],['music','Pemutar musik Spotify pada sesi CarPlay.']].map(([name,caption]) => <figure data-available-theme={availableTheme(name)}><button class="shot-button" data-lightbox data-full={fullImages[name] || lightFullImages[name]} data-full-light={lightFullImages[name]} data-caption={caption} aria-label={`Perbesar ${caption}`}><ThemeScreenshot src={image(name)} light={lightImage(name)} width={1200} alt={caption} /></button><figcaption>{caption}</figcaption></figure>)}</div></div></div></section>
      <section id="tampilan" class="gallery-section wrap" aria-labelledby="gallery-title"><div class="section-heading gallery-heading"><div><p class="section-number">03 / Seluruh tampilan</p><h2 id="gallery-title">Lihat aplikasinya.<br />Sampai ke detailnya.</h2></div><p>Jelajahi screenshot asli dengan menggeser galeri. Semua halaman tersedia, dari persiapan hingga CarPlay berjalan. Klik gambar untuk memperbesar.</p></div>
        <GalleryControls target="feature-gallery" label="halaman aplikasi" /><div id="feature-gallery" class="feature-stories scroll-gallery" tabindex="0" role="region" aria-label="Screenshot halaman aplikasi">{stories.map((story,index) => <article class="feature-story" aria-labelledby={`story-${index}`}><div class="panel-copy"><p class="section-number">0{index+1} / {story.label}</p><h3 id={`story-${index}`}>{story.title}</h3><p>{story.text}</p><ul>{story.points.map(point => <li>{point}</li>)}</ul></div><div class:list={['story-screens',{'has-landscape':story.shots.length>1 && image(story.shots[1]).width>image(story.shots[1]).height}]}>{story.shots.map(name => <figure data-available-theme={availableTheme(name)} class:list={image(name).width>image(name).height ? 'landscape-shot' : 'portrait-shot'}><button class="shot-button" data-lightbox data-full={fullImages[name] || lightFullImages[name]} data-full-light={lightFullImages[name]} data-caption={`${story.label}, ${name.includes('landscape')?'landscape':'portrait'}.`} aria-label={`Perbesar ${name}`}><ThemeScreenshot src={image(name)} light={lightImage(name)} width={image(name).width>image(name).height?1200:540} alt={`${story.label}, ${name.includes('landscape')?'landscape':'portrait'}.`} /></button><figcaption>{name.includes('landscape')?'Landscape':name==='device-technical'?'Detail teknis':'Portrait'}</figcaption></figure>)}</div></article>)}</div>
        <div class="archive-heading"><h3>Dari persiapan sampai CarPlay berjalan.</h3><p>Bantuan koneksi, informasi aplikasi, memilih iPhone, navigasi, dan musik.</p></div><GalleryControls target="session-gallery" label="detail dan sesi CarPlay" /><div id="session-gallery" class="screenshot-archive scroll-gallery" tabindex="0" role="region" aria-label="Screenshot detail dan sesi CarPlay">{archive.map(([name,label]) => <figure data-available-theme={availableTheme(name)} class:list={{'wide-shot':image(name).width>image(name).height}}><button class="shot-button" data-lightbox data-full={fullImages[name] || lightFullImages[name]} data-full-light={lightFullImages[name]} data-caption={label} aria-label={`Perbesar ${label}`}><ThemeScreenshot src={image(name)} light={lightImage(name)} width={image(name).width>image(name).height?1200:540} alt={label} /></button><figcaption>{label}</figcaption></figure>)}</div>
      </section>
      <section id="panduan" class="guide-section" aria-labelledby="guide-title"><div class="wrap"><div class="section-heading"><div><p class="section-number">04 / Mulai menghubungkan</p><h2 id="guide-title">Siapkan saat parkir.<br />Ikuti empat langkah.</h2></div><p>Siapkan iPhone, Android dengan DashTConnect, head unit dengan T-Link, dan kabel data USB. Internet tetap menggunakan iPhone.</p></div><GalleryControls target="tutorial-gallery" label="langkah tutorial" /><ol id="tutorial-gallery" class="steps scroll-gallery" tabindex="0" aria-label="Empat langkah tutorial">{steps.map(([title,text],index) => <li><span class="step-number">0{index+1}</span><div><h3>{title}</h3><p>{text}</p></div><figure class="step-screenshot" data-available-theme="dark"><button class="shot-button" data-lightbox data-full={fullImages[`tutorial-${index+1}`]} data-caption={`Langkah ${index+1}: ${title}`} aria-label={`Perbesar tutorial langkah ${index+1}`}><Image src={image(`tutorial-${index+1}`)} width={480} alt={`Tutorial langkah ${index+1}: ${title}`} format="webp" loading="lazy" /></button><figcaption>Langkah {index+1} di aplikasi</figcaption></figure></li>)}</ol></div></section>
      <section id="pertanyaan" class="faq-section wrap" aria-labelledby="faq-title"><div><p class="section-number">05 / Pertanyaan umum</p><h2 id="faq-title">Sebelum menghubungkan.</h2></div><div class="faq-list">{faqs.map(([question,answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
      <section class="project-section wrap" aria-labelledby="project-title"><div><h2 id="project-title">Ikuti perkembangan<br />DashTConnect.</h2><p>Lihat pembaruan dan pengembangan aplikasi di repository proyek.</p></div><a class="button primary" href={repo}><Icon name="github" size={21} />Buka proyek di GitHub</a></section>
    </main>
    <footer class="site-footer wrap"><div><a class="brand" href={base}><Image src={logo} width={30} height={30} alt="" />DashTConnect</a><p>iPhone, Android, dan layar mobil dalam satu alur koneksi.</p></div><div><a href="https://farhanreninda.my.id/">Farhan Reninda</a><p>Proyek independen. Apple dan CarPlay adalah merek dagang Apple Inc.</p></div></footer>
    <dialog id="screenshot-dialog" aria-labelledby="screenshot-caption"><button class="dialog-close" aria-label="Tutup screenshot"><Icon name="close" /></button><p id="screenshot-status" role="status" hidden></p><img id="screenshot-image" alt="" /><p id="screenshot-caption"></p><a id="screenshot-original" class="dialog-original" hidden>Buka file gambar</a></dialog>
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
